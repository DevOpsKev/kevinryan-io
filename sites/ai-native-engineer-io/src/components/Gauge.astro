---
// The spine gauge — the signature element (B27). One per chapter page.
// Fill height and the percentage read are driven by the reader script
// from the same scroll value as the top progress hairline (B30).
---

<aside class="gauge-col" id="gauge" aria-hidden="true">
  <div class="gauge">
    <div class="gauge-track" id="gauge-track">
      <div class="gauge-fill" id="gauge-fill"></div>
      <div class="gauge-pct" id="gauge-pct">0%</div>
    </div>
  </div>
</aside>
