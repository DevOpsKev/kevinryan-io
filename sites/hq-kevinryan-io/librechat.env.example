#=====================================================================#
#                  LibreChat — hq.kevinryan.io (vanilla)             #
#=====================================================================#
# This is the committed TEMPLATE. Real values are never committed.
# In the cluster, the non-secret values below are supplied by the
# `librechat-config` ConfigMap and the secret values by the
# `librechat-secrets` Secret (materialized from Azure Key Vault by
# ExternalSecrets — see k8s/hq-kevinryan-io/externalsecret.yaml).
#
# For local `docker compose up` development, copy this file to
# `.env` and fill in the blanks:
#   cp librechat.env.example .env
#=====================================================================#

# ── Server ──────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3080

# Trust the single Cloudflare → Traefik → pod hop.
TRUST_PROXY=1
NO_INDEX=true

# ── Domain ──────────────────────────────────────────────────────────
DOMAIN_CLIENT=https://hq.kevinryan.io
DOMAIN_SERVER=https://hq.kevinryan.io

# ── MongoDB (internal, unauthenticated for the vanilla install) ────
# In the cluster this resolves to the headless mongodb Service.
MONGO_URI=mongodb://librechat-mongodb:27017/LibreChat

# ── Search (disabled for vanilla) ───────────────────────────────────
SEARCH=false
MEILI_NO_ANALYTICS=true
# MEILI_HOST=http://meilisearch:7700
# MEILI_MASTER_KEY=

# ── Auth (LibreChat native email/password; Auth0 dropped) ───────────
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=true

# ── Secrets (generate unique values; never commit real ones) ────────
#   openssl rand -hex 32   # JWT_SECRET
#   openssl rand -hex 32   # CREDS_KEY  (must be 32 bytes)
#   openssl rand -hex 16   # CREDS_IV   (16 bytes)
JWT_SECRET=
CREDS_KEY=
CREDS_IV=

# Leave blank to use generated temporary refresh secrets from .env.temp,
# or set a persistent value:
JWT_REFRESH_SECRET=

# ── Provider keys ──────────────────────────────────────────────────
# Reused from Azure Key Vault secret `anthropic-api-key` in the cluster.
# For local dev, paste a real key here (gitignored .env only).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=user_provided

# ── RAG / admin panel / extras (disabled for vanilla) ──────────────
# RAG_API_URL=http://rag_api:8000
# ADMIN_PANEL_SESSION_SECRET=
# ENABLE_INSIGHTS=false
