# =============================================================================
# .env.agents.example — committed template (kra-platform)
# =============================================================================
# Copy this file to `.env.agents` and fill in real values:
#
#     cp .env.agents.example .env.agents
#
# `.env.agents.example` IS committed (no secrets, placeholders only).
# `.env.agents`         is gitignored — holds REAL secret values, never commit.
# Verify before editing:
#
#     git check-ignore .env.agents   # must print the path (ignored = good)
#
# This is a PUBLIC repo. If `git check-ignore .env.agents` returns nothing,
# STOP and fix .gitignore before saving any real value.
#
# Load into the current shell, then authenticate az once per session:
#
#     set -a; source .env.agents; set +a
#     az login --service-principal \
#         --username "$ARM_CLIENT_ID" \
#         --password  "$ARM_CLIENT_SECRET" \
#         --tenant    "$ARM_TENANT_ID"
#
# Deviation from ADR-012: ADR-012 mandates 1Password `op run` with `.env.tpl`
# (op:// references, no values on disk). `.env.agents` holds REAL values
# locally for agent convenience. Acceptable only because .gitignore guarantees
# it is never committed to this public repo.
# =============================================================================

# ---- Azure service principal (Terraform ARM_* + azuread provider) ----
# App registration in Azure AD with a client secret (or federated credential).
# Grant it: Reader min; Contributor to run apply; Key Vault Secrets User if
# terraform writes/reads vault secrets.
ARM_CLIENT_ID=REPLACE_WITH_SP_APP_ID_UUID
ARM_CLIENT_SECRET=REPLACE_WITH_SP_CLIENT_SECRET
ARM_TENANT_ID=REPLACE_WITH_AAD_TENANT_UUID
ARM_SUBSCRIPTION_ID=REPLACE_WITH_AZURE_SUBSCRIPTION_UUID

# azure CLI / SDK also accept these aliases (optional, same values)
AZURE_CLIENT_ID=REPLACE_WITH_SP_APP_ID_UUID
AZURE_CLIENT_SECRET=REPLACE_WITH_SP_CLIENT_SECRET
AZURE_TENANT_ID=REPLACE_WITH_AAD_TENANT_UUID
AZURE_SUBSCRIPTION_ID=REPLACE_WITH_AZURE_SUBSCRIPTION_UUID

# ---- Azure Container Registry (build/push site images) ----
ACR_NAME=REPLACE_WITH_ACR_NAME
ACR_LOGIN_SERVER=REPLACE_WITH_ACR_NAME.azurecr.io

# ---- Cloudflare (terraform cloudflare provider + wrangler) ----
CLOUDFLARE_API_TOKEN=REPLACE_WITH_CLOUDFLARE_API_TOKEN
TF_VAR_cloudflare_api_token=REPLACE_WITH_CLOUDFLARE_API_TOKEN

# Cloudflare zone IDs (not secret, but tracked in tfvars which is gitignored)
TF_VAR_cloudflare_zone_id=REPLACE_WITH_ZONE_ID
TF_VAR_cloudflare_zone_id_aiimmigrants=REPLACE_WITH_ZONE_ID
TF_VAR_cloudflare_zone_id_distributedequity=REPLACE_WITH_ZONE_ID
TF_VAR_cloudflare_zone_id_ainativeengineer=REPLACE_WITH_ZONE_ID

# ---- GitHub PAT (Flux git source + terraform github module) ----
# Classic PAT or fine-grained; needs read on the repo + Flux deploy key scope.
FLUX_GITHUB_TOKEN=REPLACE_WITH_GITHUB_PAT
TF_VAR_github_token=REPLACE_WITH_GITHUB_PAT

# ---- Kubernetes / Flux CLI ----
# Not a secret value, but cluster access isn't via env. Point KUBECONFIG at a
# kubeconfig that has RBAC on the target cluster (the current context is
# `colima`; replace with the prod/staging cluster context).
KUBECONFIG=REPLACE_WITH_PATH_TO_KUBECONFIG

# ---- Admin SSH public key (terraform VM provisioning) ----
TF_VAR_admin_ssh_public_key=REPLACE_WITH_SSH_PUBKEY

# ---- Optional: only needed for terraform apply touching these resources ----
# Auth0 (HQ app)
# TF_VAR_auth0_secret=REPLACE
# TF_VAR_auth0_issuer_base_url=REPLACE
# TF_VAR_auth0_client_id=REPLACE
# TF_VAR_auth0_client_secret=REPLACE
# TF_VAR_auth0_domain=REPLACE

# Anthropic (HQ secrets and Claude Code builder)
# TF_VAR_anthropic_api_key=REPLACE
# ANTHROPIC_API_KEY=REPLACE

# Linear / GitHub MCP (HQ integrations)
# TF_VAR_linear_api_key=REPLACE
# TF_VAR_github_mcp_token=REPLACE