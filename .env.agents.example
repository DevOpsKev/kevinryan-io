# =============================================================================
# .env.agents.example — committed template (kra-platform)
# =============================================================================
# Copy this file to `.env.agents` and fill in real values:
#
#     cp .env.agents.example .env.agents
#
# `.env.agents.example` IS committed (no secrets, placeholders only).
# `.env.agents`         is gitignored — holds REAL secret values, never commit.
# Verify before editing:
#
#     git check-ignore .env.agents   # must print the path (ignored = good)
#
# This is a PUBLIC repo. If `git check-ignore .env.agents` returns nothing,
# STOP and fix .gitignore before saving any real value.
#
# This is the SINGLE source of truth for secrets. Non-secret Terraform config
# (location, vm_size, zone IDs, repo name, admin_ssh_public_key, …) lives in
# infra/terraform.tfvars. Terraform "sensitive = true" variables are injected
# here as TF_VAR_<name>, which Terraform reads from the environment natively.
# See AGENTS.md "Local credentials" and ADR-012 for the deviation note.
#
# Load into the current shell, then authenticate az once per session:
#
#     set -a; source .env.agents; set +a
#     az login --service-principal \
#         --username "$ARM_CLIENT_ID" \
#         --password  "$ARM_CLIENT_SECRET" \
#         --tenant    "$ARM_TENANT_ID"
#
# Run terraform with secrets already in the environment:
#
#     cd infra && terraform plan
# =============================================================================

# ---- Azure service principal (Terraform ARM_* + azuread provider) ----
# App registration in Azure AD with a client secret (or federated credential).
# Grant it: Reader min; Contributor to run apply; Key Vault Secrets User if
# terraform writes/reads vault secrets.
ARM_CLIENT_ID=REPLACE_WITH_SP_APP_ID_UUID
ARM_CLIENT_SECRET=REPLACE_WITH_SP_CLIENT_SECRET
ARM_TENANT_ID=REPLACE_WITH_AAD_TENANT_UUID
ARM_SUBSCRIPTION_ID=REPLACE_WITH_AZURE_SUBSCRIPTION_UUID

# az CLI / SDK aliases (same values)
AZURE_CLIENT_ID=REPLACE_WITH_SP_APP_ID_UUID
AZURE_CLIENT_SECRET=REPLACE_WITH_SP_CLIENT_SECRET
AZURE_TENANT_ID=REPLACE_WITH_AAD_TENANT_UUID
AZURE_SUBSCRIPTION_ID=REPLACE_WITH_AZURE_SUBSCRIPTION_UUID

# ---- Azure Container Registry (docker build/push) ----
ACR_NAME=REPLACE_WITH_ACR_NAME
ACR_LOGIN_SERVER=REPLACE_WITH_ACR_NAME.azurecr.io

# ---- Kubernetes / Flux CLI ----
# K3s cluster on Azure (rg-kevinryan-io). The kubeconfig points at
# 127.0.0.1:6443, so a localhost SSH tunnel to the k3s server is required
# before kubectl/flux/k9s/kubectx can connect. Start it once per session:
#
#   ssh -fN -L 6443:127.0.0.1:6443 kr-node1
#
# (kr-node1 = the k3s server VM, defined in ~/.ssh/config.)
KUBECONFIG=$HOME/.kube/kr-k3s.yaml

# ---- Tool credentials (non-TF_VAR) ----
CLOUDFLARE_API_TOKEN=REPLACE_WITH_CLOUDFLARE_API_TOKEN
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
FLUX_GITHUB_TOKEN=REPLACE_WITH_GITHUB_PAT

# ---- Terraform secrets (TF_VAR_<name> — sensitive = true in variables.tf) ----
TF_VAR_cloudflare_api_token=REPLACE_WITH_CLOUDFLARE_API_TOKEN
TF_VAR_github_token=REPLACE_WITH_GITHUB_PAT

# HQ Auth0
TF_VAR_auth0_client_id=REPLACE_WITH_AUTH0_CLIENT_ID
TF_VAR_auth0_domain=REPLACE_WITH_AUTH0_DOMAIN
TF_VAR_auth0_issuer_base_url=REPLACE_WITH_AUTH0_ISSUER_BASE_URL
TF_VAR_auth0_secret=REPLACE_WITH_AUTH0_SECRET
TF_VAR_auth0_client_secret=REPLACE_WITH_AUTH0_CLIENT_SECRET

# HQ integrations
TF_VAR_anthropic_api_key=REPLACE_WITH_ANTHROPIC_API_KEY

# ---- LibreChat (hq.kevinryan.io) Key Vault secrets ----
# These are NOT TF_VAR_* values. They are random values generated once and
# stored directly in Azure Key Vault (kv-kevinryan-io), then materialized into
# the `librechat-secrets` Secret by ExternalSecrets
# (see k8s/hq-kevinryan-io/externalsecret.yaml). Listed here for documentation
# only — no real values are ever committed. Generate with:
#   openssl rand -hex 32   # librechat-jwt-secret
#   openssl rand -hex 32   # librechat-jwt-refresh-secret
#   openssl rand -hex 32   # librechat-creds-key (must be 32 bytes)
#   openssl rand -hex 16   # librechat-creds-iv  (16 bytes)
# `anthropic-api-key` is reused from the HQ integrations value above.
#
# NOTE: The Auth0 TF_VAR_* values above are now UNUSED after the LibreChat
# migration (Auth0 was dropped). They are left in place for now; removing the
# Auth0 Terraform resources is a separate, out-of-scope change.